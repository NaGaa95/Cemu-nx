set(CEMU_SWITCH_PGO "USE" CACHE STRING "Switch profile-guided optimization mode")
set_property(CACHE CEMU_SWITCH_PGO PROPERTY STRINGS OFF USE)
set(CEMU_SWITCH_PGO_DIR "" CACHE PATH "Override the bundled Switch GCC profiles")

if(NOT CEMU_SWITCH_PGO MATCHES "^(OFF|USE)$")
    message(FATAL_ERROR "CEMU_SWITCH_PGO must be OFF or USE")
endif()

function(cemu_switch_configure_pgo target)
    if(CEMU_SWITCH_PGO STREQUAL "OFF")
        return()
    endif()
    foreach(_compiler IN ITEMS glslang glslang-default-resource-limits SPIRV GenericCodeGen MachineIndependent OSDependent uam_objects lsfg_spirv_cross)
        if(TARGET ${_compiler})
            target_compile_options(${_compiler} PRIVATE -fno-profile-use)
        endif()
    endforeach()
    foreach(_owner IN ITEMS CemuCafe lsfg ${target})
        if(NOT TARGET ${_owner})
            continue()
        endif()
        get_target_property(_sources ${_owner} SOURCES)
        get_target_property(_directory ${_owner} SOURCE_DIR)
        foreach(_source IN LISTS _sources)
            if(_source MATCHES "LegacyShaderDecompiler|LatteShaderCache[.]cpp|WindowSystemSwitch[.]cpp|compile_uam[.]cpp|spirv_module[.]cpp")
                if(NOT IS_ABSOLUTE "${_source}")
                    set(_source "${_directory}/${_source}")
                endif()
                set_property(SOURCE "${_source}" TARGET_DIRECTORY ${_owner}
                    APPEND PROPERTY COMPILE_OPTIONS -fno-profile-use)
            endif()
        endforeach()
    endforeach()
endfunction()

if(CEMU_SWITCH_PGO STREQUAL "OFF")
    return()
endif()
if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "Switch PGO requires GCC for both C and C++")
endif()
if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "Switch PGO requires a Release build; use CEMU_SWITCH_PGO=OFF for other configurations")
endif()

if(NOT CEMU_SWITCH_PGO_DIR)
    set(_pgo_bundle "${CMAKE_SOURCE_DIR}/dist/switch/pgo")
    file(READ "${_pgo_bundle}/profiles.json" _pgo_metadata)
    string(JSON _pgo_gcc GET "${_pgo_metadata}" gcc_version)
    if(NOT CMAKE_C_COMPILER_VERSION VERSION_EQUAL _pgo_gcc OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL _pgo_gcc)
        message(FATAL_ERROR "Bundled Switch PGO profiles require GCC ${_pgo_gcc}; use CEMU_SWITCH_PGO=OFF or provide CEMU_SWITCH_PGO_DIR")
    endif()
    if(ENABLE_DEKO3D)
        set(_pgo_backend deko3d)
    else()
        set(_pgo_backend nvk)
    endif()
    set(_pgo_archive "${_pgo_bundle}/${_pgo_backend}.tar.xz")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_pgo_bundle}/profiles.json" "${_pgo_archive}")
    file(SHA256 "${_pgo_archive}" _pgo_hash)
    string(JSON _pgo_expected_hash GET "${_pgo_metadata}" ${_pgo_backend} sha256)
    if(NOT _pgo_hash STREQUAL _pgo_expected_hash)
        message(FATAL_ERROR "Invalid bundled Switch PGO archive: ${_pgo_archive}")
    endif()
    string(SUBSTRING "${_pgo_hash}" 0 12 _pgo_key)
    set(CEMU_SWITCH_PGO_DIR "${CMAKE_BINARY_DIR}/pgo/${_pgo_backend}-${_pgo_key}")
    if(NOT EXISTS "${CEMU_SWITCH_PGO_DIR}/.complete")
        file(MAKE_DIRECTORY "${CEMU_SWITCH_PGO_DIR}")
        file(ARCHIVE_EXTRACT INPUT "${_pgo_archive}" DESTINATION "${CEMU_SWITCH_PGO_DIR}")
        file(WRITE "${CEMU_SWITCH_PGO_DIR}/.complete" "${_pgo_hash}\n")
    endif()
    string(JSON _pgo_expected_count GET "${_pgo_metadata}" ${_pgo_backend} objects)
endif()

file(GLOB _pgo_data "${CEMU_SWITCH_PGO_DIR}/*.gcda")
list(LENGTH _pgo_data _pgo_count)
if(NOT _pgo_data OR (DEFINED _pgo_expected_count AND NOT _pgo_count EQUAL _pgo_expected_count))
    message(FATAL_ERROR "Missing or incomplete Switch GCC profiles in ${CEMU_SWITCH_PGO_DIR}")
endif()

set(_pgo_prefix "${CMAKE_BINARY_DIR}")
if(CMAKE_HOST_SYSTEM_NAME MATCHES "MSYS|CYGWIN")
    find_program(_pgo_cygpath cygpath REQUIRED)
    execute_process(COMMAND "${_pgo_cygpath}" -aw "${CMAKE_BINARY_DIR}"
        OUTPUT_VARIABLE _pgo_prefix OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
elseif(CMAKE_HOST_WIN32)
    file(TO_NATIVE_PATH "${CMAKE_BINARY_DIR}" _pgo_prefix)
endif()

set(_pgo_flags -O2 "-fprofile-prefix-path=${_pgo_prefix}"
    "-fprofile-use=${CEMU_SWITCH_PGO_DIR}" -fprofile-partial-training -Wno-error=coverage-mismatch)
foreach(_flag IN LISTS _pgo_flags)
    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:${_flag}>")
endforeach()
add_link_options(${_pgo_flags})
