diff --git a/source/fatfs/ff_dev.c b/source/fatfs/ff_dev.c
--- a/source/fatfs/ff_dev.c
+++ b/source/fatfs/ff_dev.c
@@ -342,6 +342,7 @@
 static int ffdev_stat(struct _reent *r, const char *file, struct stat *st)
 {
     FILINFO info = {0};
+    const char *relative = NULL;
     FRESULT res = FR_OK;
 
     ff_declare_error_state;
@@ -354,6 +355,17 @@
     if (!ffdev_fixpath(r, file, &fs_ctx, NULL)) ff_end;
 
     USBHSFS_LOG_MSG("Getting stats for \"%s\" (\"%s\").", file, __usbhsfs_dev_path_buf);
+
+    /* FatFs does not return FILINFO for a volume root. The mounted devoptab
+     * already proves it exists; report it as a directory without ff_stat. */
+    relative = strchr(__usbhsfs_dev_path_buf, ':') + 1;
+    if (relative[strspn(relative, "/")] == '\0')
+    {
+        memset(st, 0, sizeof(*st));
+        st->st_mode = S_IFDIR | S_IRWXU | S_IRWXG | S_IRWXO;
+        st->st_nlink = 1;
+        goto end;
+    }
 
     /* Get stats. */
     res = ff_stat(__usbhsfs_dev_path_buf, &info);
